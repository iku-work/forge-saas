# Staging's own settings: what differs from production. See common.env and
# docs/runbooks/staging.md.

# The Bitwarden project the deploy reads its secrets from. Not shipped to the box.
BITWARDEN_PROJECT_ID=3f6ad220-9191-4159-a745-b4fb011f148a

ENVIRONMENT=staging
DOMAIN=app-staging.mycalendar.party
MARKETING_DOMAIN=staging.mycalendar.party
STORAGE_DOMAIN=storage-staging.mycalendar.party
FRONTEND_URL=https://app-staging.mycalendar.party
ALLOWED_ORIGINS=["https://app-staging.mycalendar.party"]
AWS_ENDPOINT_URL=https://storage-staging.mycalendar.party
GOOGLE_CLIENT_ID=840945289903-0vfnodn20lgmci25lee6felr6ogrbmt5.apps.googleusercontent.com

# As backend/.env.loadtest, so the weekly scan measures the app, not the
# limiter. AUTH_RATE_LIMIT keeps its default: staging is public.
API_RATE_LIMIT=100000/minute
ORG_RATE_LIMIT=100000000/hour
