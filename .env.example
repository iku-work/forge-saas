# Docker Compose's own environment, read from `.env` in this directory.
#
# This is NOT backend/.env. That file is handed to containers via `env_file:`
# and is never consulted for `${...}` interpolation in the compose files --
# compose only ever interpolates from the shell and from this file. A variable
# that a compose file interpolates therefore has to be here, or the expansion
# silently falls back to its default and the stack boots looking fine.
#
# Copy to `.env` and fill in before running docker compose in production:
#
#     cp .env.example .env

# The public hostname MinIO is served on -- must match STORAGE_DOMAIN in
# backend/.env exactly.
#
# docker-compose.prod.yml gives the caddy service this as a network alias, so
# that the backend and worker resolve it to the caddy container instead of
# going out to the internet and back. They have to use the public name (there
# is only one AWS_ENDPOINT_URL, and the presigned URLs built from it are handed
# to browsers), so without the alias every server-side S3 call crosses whatever
# CDN or WAF fronts the domain. When that is Cloudflare, its bot protection
# answers 403 to some of them and uploads fail at the confirm step.
#
# Leave unset when storage is a managed service (S3, R2): there is no local
# MinIO to reach, and the alias falls back to a harmless placeholder.
STORAGE_DOMAIN=storage.example.com
