{$DOMAIN} {
	# Inside a `handle`, not a bare `respond /metrics 404`. Caddy sorts
	# `handle` ahead of `respond` in its default directive order, so with any
	# handle block present the catch-all matched /metrics first and the
	# respond never ran -- the rule read correctly and did nothing. Verified
	# by request, not by reading: it answered 200 with the SPA shell. Handle
	# blocks are mutually exclusive and evaluated in written order, so this
	# must stay above the catch-all.
	handle /metrics {
		respond 404
	}

	# The backend owns exactly two prefixes -- verified against the OpenAPI
	# document plus main.py's health routes -- and everything else is the SPA.
	# Without this split the catch-all reverse_proxy swallowed every frontend
	# route, so a hard refresh on /settings/billing or an invite deep link was
	# answered by FastAPI with a 404 instead of by the app shell.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health* {
		reverse_proxy backend:8000
	}

	# Disabled outside dev (main.py passes docs_url=None), so these exist only
	# to make that a clean 404 from FastAPI rather than the SPA's index.html
	# served with a 200.
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /redoc* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# apps/web's dist, bind-mounted read-only (see docker-compose.prod.yml).
	# try_files falls back to index.html for anything that is not a real
	# asset, which is what a client-side-routed SPA (TanStack Router) needs.
	# Built on the host before `docker compose up`, exactly like
	# apps/marketing/dist already is.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	# Caddy auto-obtains and renews Let's Encrypt cert — no config needed
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 301
}

# Object storage, when it runs on this box (docker-compose.prod.yml's minio
# service). Its own host because there is only one AWS_ENDPOINT_URL in the
# application: the presigned upload and download URLs the backend signs are
# handed straight to the browser, so the endpoint has to be one the browser can
# resolve and trust. A SigV4 download signature covers the Host header, so
# rewriting the host client-side is not an option either.
#
# Access control is the signature, not the network -- the same model S3 itself
# uses. What must never be published is the MinIO console on 9001, which is why
# the service exposes no ports and only :9000 is proxied here.
#
# Default is a `.localhost` name nobody resolves, for the same reason
# MARKETING_DOMAIN's is: a deployment using S3 or R2 has no local MinIO, and
# forgetting to set this should cost you a storage host nobody can reach rather
# than an edge that refuses to start.
{$STORAGE_DOMAIN:storage.localhost} {
	reverse_proxy minio:9000

	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

# T-307: apps/marketing, on its own host.
#
# `{$MARKETING_DOMAIN}` -- the apex domain, with the app on `app.` -- separate
# hosts, not a path split. A path split would mean moving every apps/web route
# under /app/* (breaking TanStack Router's basepath, every Playwright spec,
# every invite link and every transactional email URL) or maintaining an
# allowlist of marketing path prefixes here. Neither is worth it, and leaving
# `{$DOMAIN}` above to the app alone is what lets every existing E2E spec, ZAP
# config, k6 target and transactional email URL carry on working untouched.
#
# `MARKETING_DOMAIN` is read from backend/.env, the same env file this
# service already loads for `DOMAIN` (see docker-compose.prod.yml). Leaving it
# unset serves marketing on a `.localhost` name nobody resolves rather than
# refusing to start -- see the generator for why that is the safe default.
#
# **Do not widen the session cookie to a parent domain.** T-220 already lost a
# session to a cross-origin redirect once. Marketing is static and needs no
# session at all, so the app's refresh cookie stays scoped to the app host --
# it is named `__Host-refresh_token` (backend/app/modules/auth/router.py),
# and the `__Host-` prefix means a browser *rejects* it outright if a Domain
# attribute is ever added, which is the guard rail rather than the reminder.
# If marketing ever needs to know whether someone is signed in, that is a
# public, cacheable endpoint, not a cookie.
#
# The block itself is generated -- apps/marketing/scripts/caddy-site.mjs
# writes it on every `astro build`, because the CSP names each inline script
# by hash and the locale redirects follow product.config.ts. With
# `modules.marketing: false` the file is deleted instead, and this glob then
# matches nothing: Caddy logs a warning and the app host above is unaffected,
# which is also what happens in any stack that never builds the frontend (the
# ZAP baseline job, a fresh clone).
import /etc/caddy/conf.d/*.caddy
