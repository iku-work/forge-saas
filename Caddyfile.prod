{$DOMAIN} {
	respond /metrics 404
	reverse_proxy backend:8000
	# Caddy auto-obtains and renews Let's Encrypt cert — no config needed
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 301
}
