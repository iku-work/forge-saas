{
  "id": null,
  "uid": "forge-database",
  "title": "Forge · Database",
  "tags": ["forge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connection pool usage vs size",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_db_pool_used",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_db_pool_size",
          "legendFormat": "size",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pool utilization",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * forge_db_pool_used / forge_db_pool_size",
          "legendFormat": "utilization",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "text",
      "title": "Connection wait / slow queries — deferred",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "options": {
        "mode": "markdown",
        "content": "No connection-wait-time metric is currently emitted (only pool used/size gauges from T-202). The \"hall of shame\" slow-query panel (top statements by total time, via `pg_stat_statements`) lands here in T-205, which depends on this dashboard already existing."
      }
    }
  ]
}
