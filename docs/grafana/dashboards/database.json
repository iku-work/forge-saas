{
  "id": null,
  "uid": "forge-database",
  "title": "Forge · Database",
  "tags": ["forge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connection pool usage vs size",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_db_pool_used",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_db_pool_size",
          "legendFormat": "size",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pool utilization",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * forge_db_pool_used / forge_db_pool_size",
          "legendFormat": "utilization",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "text",
      "title": "Connection wait — deferred",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 8 },
      "options": {
        "mode": "markdown",
        "content": "No connection-wait-time metric is currently emitted (only the pool used/size gauges from T-202)."
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Hall of shame — top 10 statements by total execution time",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, pg_stat_statements_total_exec_time)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mean execution time by statement",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pg_stat_statements_mean_exec_time > 100",
          "legendFormat": "{{queryid}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "text",
      "title": "About this data",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 22 },
      "options": {
        "mode": "markdown",
        "content": "`pg_stat_statements` (T-205) exposes **mean**/max execution time per normalized statement, not a true percentile. The alert in `docs/grafana/alerts.yml` fires on mean execution time > 500ms sustained over 15m with 100+ calls, as a pragmatic stand-in — true end-to-end p95 is owned by the k6 load-test suite (T-223). See `docs/runbooks/slow-queries.md` for how to act on this panel."
      }
    }
  ]
}
