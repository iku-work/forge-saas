{
  "id": null,
  "uid": "forge-workers",
  "title": "Forge · Workers",
  "tags": ["forge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ARQ queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_arq_queue_depth",
          "legendFormat": "pending jobs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Emails sent",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(forge_emails_sent_total[5m])",
          "legendFormat": "emails/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Push notifications sent",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(forge_push_sent_total[5m])",
          "legendFormat": "push/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "Job duration / failure rate — deferred",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "mode": "markdown",
        "content": "ARQ has no official Prometheus instrumentation (see T-203). Per-job duration and failure-rate panels are deferred until a future task adds `forge_arq_job_duration_seconds` / `forge_arq_job_failures_total` collectors — job-level detail is currently only available as OpenTelemetry spans (`arq.<job_name>`, T-203), not Prometheus metrics."
      }
    }
  ]
}
