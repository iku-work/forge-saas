{
  "id": null,
  "uid": "forge-workers",
  "title": "Forge · Workers",
  "tags": ["forge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ARQ queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_arq_queue_depth",
          "legendFormat": "pending jobs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Emails sent",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(forge_emails_sent_total[5m])",
          "legendFormat": "emails/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Push notifications sent",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(forge_push_sent_total[5m])",
          "legendFormat": "push/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "Job duration / failure rate — deferred",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "mode": "markdown",
        "content": "ARQ has no official Prometheus instrumentation (see T-203). Per-job duration and failure-rate panels are deferred until a future task adds `forge_arq_job_duration_seconds` / `forge_arq_job_failures_total` collectors — job-level detail is currently only available as OpenTelemetry spans (`arq.<job_name>`, T-203), not Prometheus metrics."
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Key rotation — rows remaining",
      "description": "T-245. Published to Redis by the rotation job's own process and served by the backend, so this has data wherever the job runs. Flat at 0 when no rotation is in flight; stuck above 0 means an interrupted run — see docs/runbooks/encryption-key-rotation.md.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_reencrypt_remaining",
          "legendFormat": "rows left to scan",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Key rotation — throughput and batch latency",
      "description": "T-245. Unlike the gauge, these live in the registry of whichever process runs the job — they only have data if that process is itself scraped.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(forge_reencrypt_rows_total[5m])",
          "legendFormat": "{{table}}.{{column}} rows/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(forge_reencrypt_batch_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 batch seconds",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webhook deliveries — queue depth",
      "description": "T-321. Deliveries awaiting an attempt, counted in the worker and published through Redis for /metrics to read back — the same split forge_active_sessions lives with. Deliberately not forge_arq_queue_depth: a delivery whose job has been consumed and whose next attempt is two hours away is still work owed to somebody, and the ARQ queue cannot see it. A depth that climbs and never falls is a worker that is not consuming, not a slow consumer.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "forge_webhook_queue_depth",
          "legendFormat": "pending deliveries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Webhook deliveries — rate by outcome",
      "description": "T-321. `dead` is the series to alert on: a delivery that exhausted the whole ladder (1 m, 5 m, 30 m, 2 h, 12 h) and will not be retried. `failed` rising while `delivered` holds steady is one consumer having a bad day; both falling to zero together is this product not emitting at all.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(forge_webhook_deliveries_total[5m])",
          "legendFormat": "{{outcome}}/s",
          "refId": "A"
        }
      ]
    }
  ]
}
