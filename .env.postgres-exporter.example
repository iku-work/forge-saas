# T-205: config for docker-compose.prod.yml's postgres-exporter service.
#
# Deliberately its own file rather than a new key in backend/.env.example --
# Settings (backend/app/core/config.py) sets extra="forbid", so any
# undeclared key in backend/.env makes the whole backend refuse to start.
# postgres_exporter isn't a Settings-governed process; it doesn't belong there.
#
# Copy to .env.postgres-exporter and fill in real values; do not commit the
# real file.

# postgres_exporter's own DSN format (plain "postgresql://", not
# DATABASE_URL's "+asyncpg" driver suffix). Keep user/pass/host/db in sync
# with backend/.env's DATABASE_URL. sslmode=disable is fine here since this
# connection never leaves the private Docker network.
DATA_SOURCE_NAME=postgresql://postgres:postgres@postgres:5432/forge?sslmode=disable
