# T-244: config for docker-compose.prod.yml's postgres service.
#
# Deliberately its own file rather than keys in backend/.env, for the same
# reason as .env.postgres-exporter.example: POSTGRES_* are postgres-image
# variables, not fields on Settings (backend/app/core/config.py), which sets
# extra="forbid" and refuses to load a dotenv file containing anything it
# doesn't declare.
#
# Copy to .env.postgres and fill in real values; do not commit the real file.
#
# This is the superuser, for migrations and backups only. The deploy builds
# MIGRATIONS_DATABASE_URL from this file while it migrates, so the password is
# never in the application's environment or in Bitwarden. The application and the
# exporter have their own accounts (scripts/provision-db-roles.sh).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge
