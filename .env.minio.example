# Config for docker-compose.prod.yml's minio service, when object storage runs
# on the same box rather than coming from S3 or R2.
#
# Its own file rather than keys in backend/.env, for the same reason as
# .env.postgres.example and .env.pgbouncer.example: none of these are fields on
# Settings (backend/app/core/config.py), which sets extra="forbid", so putting
# them there would stop the backend booting.
#
# Copy to .env.minio and fill in real values; do not commit the real file.

# The credentials MinIO itself starts with. These are also what the backend
# authenticates with -- set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in
# backend/.env to the same pair.
#
# Generate the password; do not ship "minioadmin" anywhere reachable from the
# internet, and this one is: presigned uploads only work if the browser can
# reach the storage endpoint, so it is behind Caddy on a public hostname with
# request signatures as the access control.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MINIO_ROOT_USER=forge
MINIO_ROOT_PASSWORD=change-me

# Required, not optional. Every upload this app presigns carries
# `x-amz-server-side-encryption: AES256` as a policy condition (see
# _SSE_ALGORITHM in backend/app/modules/storage/backends/s3.py), and MinIO only
# honours SSE-S3 when a KMS is configured. Without this key every upload is
# rejected by the policy it was signed with -- which reads as a permissions
# problem and is not one.
#
# Format is `<name>:<base64 of 32 random bytes>`. Generate with:
#   python -c "import base64,secrets; print('forge-prod:' + base64.b64encode(secrets.token_bytes(32)).decode())"
#
# BACK THIS UP OFF THE BOX. It decrypts the objects. Losing it loses every
# uploaded file, exactly like losing ENCRYPTION_KEY loses the encrypted
# columns.
MINIO_KMS_SECRET_KEY=change-me

# Created on first boot by the minio-init service. Keep in sync with
# AWS_BUCKET_NAME in backend/.env.
MINIO_BUCKET=forge
