# Config for docker-compose.prod.yml's redis service.
#
# Its own file rather than a key in backend/.env, for the same reason as
# .env.postgres.example: this is not a field on Settings, which sets
# extra="forbid". The application reads the password from REDIS_URL
# (redis[s]://:<password>@redis:6379/0), so keep the two in sync.
#
# Copy to .env.redis and fill in a real value; do not commit the real file.
# scripts/gen-infra-secrets.sh does this on a server.
REDIS_PASSWORD=change-me
