{
	# T-210's ZAP baseline scan container connects over forge-net and, unlike
	# every browser and curl, opens its very first TLS probe with no SNI
	# extension at all -- confirmed with `openssl s_client -connect caddy:443`
	# (no -servername): Caddy has no cert to offer and drops the connection
	# with a bare "internal_error" alert. default_sni tells it which of the
	# certs below to serve when SNI is absent, instead of failing closed.
	default_sni caddy
}

localhost, caddy {
	# "caddy" is the service's own name on forge-net -- the ZAP scan has no
	# route to "localhost" (that resolves to the scanner container itself),
	# so it targets https://caddy instead. Both hostnames need their own tls
	# internal leaf cert, which is why they're both site addresses here
	# rather than "localhost" alone.
	# Inside a `handle`, not a bare `respond /metrics 404`. Caddy sorts
	# `handle` ahead of `respond` in its default directive order, so with any
	# handle block present the catch-all matched /metrics first and the
	# respond never ran -- the rule read correctly and did nothing. Verified
	# by request, not by reading: it answered 200 with the SPA shell. Handle
	# blocks are mutually exclusive and evaluated in written order, so this
	# must stay above the catch-all.
	handle /metrics {
		respond 404
	}

	# T-220: everything the backend actually owns goes to it; everything
	# else falls through to the SPA below. Without this split, the
	# catch-all reverse_proxy that used to sit here would swallow every
	# frontend route (e.g. /verify-email, /accept-invitation/*) and the
	# backend would 404 them itself.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /redoc* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# apps/web's dist, bind-mounted read-only into /srv/web (see
	# docker-compose.yml's caddy service). try_files falls back to
	# index.html for any path that isn't a real static asset -- required
	# for a client-side-routed SPA (TanStack Router) so a deep link like
	# /accept-invitation/<token> or a hard refresh on /settings/billing
	# still loads the app shell instead of 404ing.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# Vite content-hashes everything under /assets, so those URLs can never
		# change meaning and are safe to keep forever. index.html is the
		# opposite: one stable URL whose contents name the current bundle, so a
		# cached copy pins a browser to whatever build it was fetched during.
		#
		# It had no Cache-Control at all, which leaves the browser to invent a
		# heuristic freshness window from Last-Modified -- and a tab opened
		# before a deploy then keeps serving the previous app, with no error to
		# suggest why a shipped feature is missing. `no-cache` still allows the
		# 304 round trip; it only forbids using the copy without asking.
		#
		# Same split as apps/marketing/caddy/*/marketing.caddy uses for
		# /_astro/*, for the same reason.
		@web_immutable path /assets/*
		@web_revalidated not path /assets/*
		header @web_immutable Cache-Control "public, max-age=31536000, immutable"
		header @web_revalidated Cache-Control "no-cache"
	}

	tls internal
}

http://localhost, http://caddy {
	redir https://{host}{uri} 301
}

# T-307: apps/marketing, on its own host.
#
# `marketing.localhost` locally, the apex domain in production -- separate
# hosts, not a path split. A path split would mean moving every apps/web route
# under /app/* (breaking TanStack Router's basepath, every Playwright spec,
# every invite link and every transactional email URL) or maintaining an
# allowlist of marketing path prefixes here. Neither is worth it, and keeping
# `localhost` as the app is what lets every existing E2E spec, ZAP config and
# k6 target carry on working untouched.
#
# **Do not widen the session cookie to a parent domain.** T-220 already lost a
# session to a cross-origin redirect once. Marketing is static and needs no
# session at all, so the app's refresh cookie stays scoped to the app host --
# it is named `__Host-refresh_token` (backend/app/modules/auth/router.py),
# and the `__Host-` prefix means a browser *rejects* it outright if a Domain
# attribute is ever added, which is the guard rail rather than the reminder.
# If marketing ever needs to know whether someone is signed in, that is a
# public, cacheable endpoint, not a cookie.
#
# The block itself is generated -- apps/marketing/scripts/caddy-site.mjs
# writes it on every `astro build`, because the CSP names each inline script
# by hash and the locale redirects follow product.config.ts. With
# `modules.marketing: false` the file is deleted instead, and this glob then
# matches nothing: Caddy logs a warning and the app host above is unaffected,
# which is also what happens in any stack that never builds the frontend (the
# ZAP baseline job, a fresh clone).
import /etc/caddy/conf.d/*.caddy
