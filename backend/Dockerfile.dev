FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# `node` only -- no npm/pnpm, no node_modules. send_email (T-106) shells out
# to packages/email-templates' compiled, dependency-free cli.js, bind-mounted
# in by docker-compose.yml; nothing here ever runs `npm install`.
# `libmagic1` backs python-magic (T-225's content-sniffing on upload confirm).
RUN apt-get update && apt-get install -y --no-install-recommends nodejs libmagic1 \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# The same lock CI installs (C1), so "works in the dev container" and "green
# in CI" are claims about the same dependency set.
RUN pip install --no-cache-dir --require-hashes -r requirements-dev.lock \n    && pip install --no-cache-dir --no-deps -e .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0"]
