# T-223: same dummy-but-well-formed fixture as .env.e2e, copied to `.env` to
# boot the docker-compose stack `make load-test` / the nightly load-test CI
# job run k6 against. Differs from .env.e2e in four fields:
#   - AUTH_RATE_LIMIT=100000/minute (not 1000/minute). login-burst.js's whole
#     purpose is to hammer POST /auth/login from k6's single source IP --
#     app.middleware.rate_limit keys AUTH_RATE_LIMIT by client IP
#     (slowapi.util.get_remote_address, which does NOT read X-Forwarded-For),
#     so every k6 VU shares one bucket regardless of which of the 50 seeded
#     load-test accounts each iteration logs in as. The production-appropriate
#     5/minute default (and even T-220's 1000/minute) exists to throttle
#     exactly this pattern from a real single-IP attacker -- raised further
#     here only because this stack is ephemeral and never reachable outside
#     the nightly runner / a developer's own machine.
#   - API_RATE_LIMIT=100000/minute (not the 100/minute default). This one is
#     keyed per-user (once authenticated), and it's a single shared budget
#     across every api_limit-gated endpoint, not one bucket per endpoint --
#     browse.js's three list calls (members/notifications/files) all draw
#     from the same 100/minute allowance for whichever seeded account that
#     VU is logged in as. A real dashboard user reading three lists at
#     realistic think-time speed would never come close to 100 req/minute,
#     but a k6 VU with only a couple seconds of sleep between requests does
#     -- confirmed by running browse.js against the unmodified 100/minute
#     default first: exactly 100 requests per user succeeded before every
#     subsequent one 429'd, which is what sent this here.
#   - DB_ECHO=false, set explicitly below alongside DATABASE_URL/REDIS_URL --
#     see that line's own comment.
#   - DB_POOL_SIZE=30 / DB_MAX_OVERFLOW=30 (not 5/15) -- also set below
#     alongside DATABASE_URL/REDIS_URL, see that comment.
# See backend/app/core/seed_load.py for what this stack gets seeded with.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forge_test
REDIS_URL=redis://localhost:6379/1

# T-223: ENVIRONMENT=dev below defaults app.core.db's engine to
# SQLAlchemy echo=True (every SQL statement logged synchronously, with
# parameters, on the request path) -- convenient for local debugging, but
# mixed.js's ramp to 50 concurrent VUs showed this alone drags p(95) to
# ~900ms with zero actual errors. No production deployment runs with this
# on, so leaving it on here would make this stack's numbers meaningless as
# a regression signal. See config.py's DB_ECHO for why this is its own
# setting rather than piggybacking further on ENVIRONMENT.
DB_ECHO=false

# T-223: the 5 + 15-overflow default (config.py's DB_POOL_SIZE/DB_MAX_OVERFLOW)
# is a real capacity number, not overhead like DB_ECHO above -- 20 total
# connections queuing requests under mixed.js's sustained ~80 req/s across 50
# VUs is exactly the kind of undersized-for-its-traffic behavior a single
# unscaled replica would show in production too. Postgres here allows up to
# 100 connections (`max_connections`), so there's ample headroom to size this
# stack's pool to what it's actually being asked to serve.
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=30

