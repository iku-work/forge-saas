# T-244: dummy-but-well-formed fixture (same key material as .env.test /
# .env.e2e / .env.loadtest), copied to `backend/.env` by CI's
# `pgbouncer-prod-compose` job to boot docker-compose.prod.yml. It exists to
# prove one thing the other env files can't: that the *production* stack --
# where every backend and worker connection is routed through pgbouncer in
# transaction mode -- actually boots, reports /health/ready, and serves
# requests.
#
# Differs from .env.e2e in exactly the pooling block below:
#   - DATABASE_URL points at the pgbouncer service on :6432, not postgres:5432
#   - MIGRATIONS_DATABASE_URL points straight at postgres:5432 (alembic must
#     not go through a transaction pooler -- docs/adr/0002-pgbouncer.md)
#   - PGBOUNCER_ENABLED=true, which switches app/core/db.py to the
#     prepared-statement-free connection setup that pooling requires
#
# ENVIRONMENT stays "dev": the CI stack has no TLS between containers, and
# staging/prod would additionally demand sslmode=require on both DSNs plus
# rediss:// (enforced in app/core/config.py, covered by tests/test_config.py
# and tests/test_pgbouncer.py) -- none of which this job is testing.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@pgbouncer:6432/forge
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/forge
PGBOUNCER_ENABLED=true
REDIS_URL=redis://redis:6379/0

