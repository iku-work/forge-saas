# T-220: same dummy-but-well-formed fixture as .env.test, copied to `.env`
# to boot the docker-compose stack for Playwright E2E (mirrors T-210's
# zap-baseline CI job, which does the same `cp .env.test .env`). Differs
# from .env.test in exactly two fields:
#   - EMAIL_BACKEND=smtp (not "resend") so verification/invitation emails
#     actually land in MailHog instead of attempting a real Resend API call
#     with a dummy key.
#   - FRONTEND_URL=https://localhost (not the vite dev server's :5173) so
#     the links those emails carry point at the Caddy-served build this
#     suite drives a real browser against.
# docker-compose.yml's own `environment:` block already overrides SMTP_HOST
# to "mailhog" (the compose service name) for both backend and worker
# regardless of what's in this file.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forge_test
REDIS_URL=redis://localhost:6379/1

# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY and ENCRYPTION_KEY are generated per run,
# never committed: `node ../scripts/gen-test-secrets.mjs >> .env` after copying this file.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=dev
ALLOWED_ORIGINS=["https://localhost"]
LOG_LEVEL=INFO
DOMAIN=localhost
FRONTEND_URL=https://localhost

# T-220: the acceptance journey registers/verifies/logs in two accounts
# (owner + teammate) from the test runner's single IP -- 6+ calls against
# app.middleware.rate_limit's IP-keyed auth_limit, comfortably over the
# production-appropriate 5/minute default (backend/app/core/config.py).
# Loosened here only; every other env file keeps the real default.
AUTH_RATE_LIMIT=1000/minute
# Review R5's shared budgets: one Playwright journey is one user in one org,
# clicking far faster than a person does. Loosened here only.
API_RATE_LIMIT=1000/minute
ORG_RATE_LIMIT=100000/hour

STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
RESEND_API_KEY=re_dummy
EMAIL_FROM_ADDRESS=ForgeSaaS <noreply@example.com>
EMAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SENTRY_DSN=

STORAGE_BACKEND=minio
AWS_BUCKET_NAME=forge-test
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://minio:9000

ENCRYPTION_KEY_OLD=

FORCE_HTTPS=false

GDPR_PURGE_GRACE_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

VIRUS_SCANNER=noop
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
VIRUSTOTAL_API_KEY=

PASSWORD_PEPPER=
