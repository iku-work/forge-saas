# Fixture for tests/test_config.py and any other test that needs a fully valid
# Settings instance. Not used by the running app — only loaded explicitly via
# Settings(_env_file=".env.test", ...). Values are dummy but well-formed.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forge_test
REDIS_URL=redis://localhost:6379/1

# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY and ENCRYPTION_KEY are generated per run,
# never committed: see backend/tests/_test_env.py.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Explicit even though these match Settings' own class defaults exactly --
# tests/conftest.py's _settings_env fixture only monkeypatches real env vars
# for keys *present* in this file; a field this file omits still falls
# through to backend/.env (pydantic-settings' env_file=".env" is consulted
# per-field, not disabled just because some other field came from a real env
# var). A developer's own backend/.env legitimately overrides AUTH_RATE_LIMIT
# for local E2E work (see .env.e2e's own comment) -- omitted here, that
# value silently leaked into every rate-limit test on that machine, making
# "the 6th call gets 429" false whenever the real limit is far above 5/minute.
AUTH_RATE_LIMIT=5/minute
SENSITIVE_RATE_LIMIT=3/minute
API_RATE_LIMIT=100/minute
# T-312: deliberately tiny, and this file is where the per-key limit is
# proven to be read from configuration rather than baked in at import --
# test_api_key_rate_limit.py monkeypatches it and expects behaviour to
# follow on the very next request, which is the regression test for the
# import-time-binding trap the three lines above describe.
API_KEY_RATE_LIMIT_PER_MINUTE=5

ENVIRONMENT=dev
ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
RESEND_API_KEY=re_dummy
EMAIL_FROM_ADDRESS=ForgeSaaS <noreply@example.com>
EMAIL_BACKEND=resend
SMTP_HOST=localhost
SMTP_PORT=1025
SENTRY_DSN=

STORAGE_BACKEND=minio
AWS_BUCKET_NAME=forge-test
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000

ENCRYPTION_KEY_OLD=

FORCE_HTTPS=false

GDPR_PURGE_GRACE_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

VIRUS_SCANNER=noop
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
VIRUSTOTAL_API_KEY=

PASSWORD_PEPPER=

# Cheap Argon2 for the suite: ~1 ms per hash instead of ~50 ms. Refused
# outside dev by Settings' startup invariants.
ARGON2_TIME_COST=1
ARGON2_MEMORY_KIB=8
ARGON2_PARALLELISM=1
