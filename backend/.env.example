# Copy to .env and fill in real values. Every field here maps to a field on
# Settings in app/core/config.py — keep the two in sync.

# --- Database ---
# Async Postgres DSN (asyncpg driver). docker-compose's postgres service by default.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forge
# Redis DSN. docker-compose's redis service by default.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# RS256 keypair (PEM). Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste each PEM verbatim, wrapped in double quotes so the embedded newlines survive.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
# "dev" | "staging" | "prod". Anything but "dev" enforces FORCE_HTTPS and forbids "*" origins.
ENVIRONMENT=dev
# JSON array of allowed CORS origins, e.g. ["https://app.example.com"]. Never "*" outside dev.
ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# Public domain Caddy terminates TLS for. Used by Caddyfile.prod ($DOMAIN) in staging/prod.
DOMAIN=localhost
# Base URL for links embedded in transactional emails (verify/reset/magic-link/invite).
FRONTEND_URL=http://localhost:5173

# --- Integrations ---
# Only required when billing is enabled in backend/product/config.py (T-065).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
# Must be on a domain verified with Resend (real envs) — MailHog accepts any value in dev.
EMAIL_FROM_ADDRESS=ForgeSaaS <noreply@example.com>
# "resend" (real Resend HTTP API) | "smtp" (local MailHog catcher — see docker-compose.yml).
# Use "smtp" in dev so you can actually read verification/reset/invite emails at
# http://localhost:8025 without a real Resend account.
EMAIL_BACKEND=resend
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional. Leave unset to disable Sentry locally.
SENTRY_DSN=
# Fraction of requests traced (0.0-1.0). Ignored while SENTRY_DSN is unset.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Social OAuth (T-023) ---
# Leave a provider's pair blank to disable its /api/v1/auth/oauth/{provider} route.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Storage ---
# "s3" | "r2" | "minio"
STORAGE_BACKEND=minio
AWS_BUCKET_NAME=forge-local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Only set for MinIO/R2 (S3-compatible custom endpoint). Leave unset for real AWS S3.
AWS_ENDPOINT_URL=http://localhost:9000

# --- Encryption (column-level Fernet, see EncryptedString in T-009.5) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated legacy keys, only set during key rotation.
ENCRYPTION_KEY_OLD=

# --- TLS enforcement ---
# Must be "true" in staging/prod — startup raises RuntimeError otherwise (§0.6).
FORCE_HTTPS=false

# --- GDPR (T-033) ---
# Days between DELETE /me (soft-delete) and the purge_user_data hard-delete job (T-036).
GDPR_PURGE_GRACE_DAYS=30

# --- Notifications (T-103) ---
# Global cap on concurrently open /api/v1/notifications/stream SSE connections.
SSE_MAX_CONNECTIONS=10000

# --- Virus scanning (T-113) ---
# "clamav" | "virustotal" | "noop". "noop" (default) marks every upload clean immediately.
VIRUS_SCANNER=noop
# Only used when VIRUS_SCANNER=clamav. docker-compose.prod.yml's optional clamav service.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Only used when VIRUS_SCANNER=virustotal.
VIRUSTOTAL_API_KEY=

# --- Superadmin (T-140) ---
# Dedicated Loguru sink every superadmin action is written to, in addition to
# the normal log stream. Relative paths resolve against the backend process's cwd.
ADMIN_AUDIT_LOG_PATH=admin-audit.log
