# Copy to .env and fill in real values. Every field here maps to a field on
# Settings in app/core/config.py — keep the two in sync.

# --- Database ---
# Async Postgres DSN (asyncpg driver). docker-compose's postgres service by default.
# Outside dev, must include ?sslmode=require (or stricter) — startup raises RuntimeError
# otherwise (T-225). See docs/runbooks/backup-restore.md's "Docker-network TLS" section
# for the self-hosted (docker-compose.prod.yml) setup; Render's managed Postgres already
# requires TLS on its external connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forge

# --- Connection pooling (T-244) ---
# Leave these at their defaults in dev: docker-compose.yml talks to Postgres
# directly, one less moving part locally.
#
# docker-compose.prod.yml puts pgbouncer (transaction mode) in front of
# Postgres, and a production deployment there sets all three of:
#   DATABASE_URL=postgresql+asyncpg://user:pass@pgbouncer:6432/forge?sslmode=require
#   MIGRATIONS_DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/forge?sslmode=require
#   PGBOUNCER_ENABLED=true
#
# PGBOUNCER_ENABLED=true switches app/core/db.py to a connection setup that
# survives having its server connection swapped at every transaction boundary
# (no prepared-statement reuse — see build_connect_args there).
# MIGRATIONS_DATABASE_URL is where `alembic upgrade` connects: migrations must
# bypass the pooler (session-level advisory locks + multi-statement DDL don't
# survive transaction pooling). Unset means "same as DATABASE_URL"; startup
# raises RuntimeError if PGBOUNCER_ENABLED is true and it isn't set to
# something different. See docs/adr/0002-pgbouncer.md.
PGBOUNCER_ENABLED=false

# --- Read replica (T-246) ---
# Leave blank. Blank means "no replica": app/core/db.py binds read_engine to
# write_engine, so the handful of repository reads that can opt into a replica
# (`use_read_replica=True`) are answered by the primary exactly as they always
# were — zero behaviour change, no second connection pool.
#
# Set it only when the trigger in docs/adr/0003-read-replica.md has actually
# fired (sustained primary CPU from read traffic, or read-driven pool
# exhaustion), and read the activation checklist there first — a replica is
# asynchronous, so anything routed to it is read from a slightly older copy of
# the database. Auth reads (sessions, tokens, memberships) never go there, and
# that is enforced in code, not by convention.
#
# Outside dev this must carry sslmode=require (or stricter), like the other two
# DSNs. Never point Alembic here: migrations use MIGRATIONS_DATABASE_URL.
READ_REPLICA_URL=
MIGRATIONS_DATABASE_URL=

# Redis DSN. docker-compose's redis service by default.
# Outside dev, must use the rediss:// scheme — startup raises RuntimeError otherwise (T-225).
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# RS256 keypair (PEM). Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste each PEM verbatim, wrapped in double quotes so the embedded newlines survive.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
# "dev" | "staging" | "prod". Anything but "dev" enforces FORCE_HTTPS and forbids "*" origins.
ENVIRONMENT=dev
# JSON array of allowed CORS origins, e.g. ["https://app.example.com"]. Never "*" outside dev.
ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# Public domain Caddy terminates TLS for. Used by Caddyfile.prod ($DOMAIN) in staging/prod.
# This is the *app* host: with T-307's marketing site at the apex, it is app.example.com.
DOMAIN=localhost
# T-307: the marketing host (apps/marketing), which is the apex domain. Read only by
# Caddyfile.prod's generated marketing block. Must never be blank — Caddy substitutes an
# empty env var as an empty site address and then refuses to start the whole edge, app
# host included. The value below is a name nobody resolves, which is the right thing to
# be serving marketing on until you change it. Set it together with PRODUCTION_ORIGIN in
# apps/marketing/src/config/indexing.ts, or the site is served but never indexed — see
# docs/runbooks/deploy-render.md.
MARKETING_DOMAIN=marketing.localhost
# Base URL for links embedded in transactional emails (verify/reset/magic-link/invite).
FRONTEND_URL=http://localhost:5173
# Custom URL scheme the mobile app registers — must match apps/mobile/app.json's
# `expo.scheme`. Used to build the T-261 impersonation handoff deep link.
MOBILE_DEEP_LINK_SCHEME=forge

# --- Integrations ---
# Only required when billing is enabled in backend/product/config.py (T-065).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
# Must be on a domain verified with Resend (real envs) — MailHog accepts any value in dev.
EMAIL_FROM_ADDRESS=ForgeSaaS <noreply@example.com>
# "resend" (real Resend HTTP API) | "smtp" (local MailHog catcher — see docker-compose.yml).
# Use "smtp" in dev so you can actually read verification/reset/invite emails at
# http://localhost:8025 without a real Resend account.
EMAIL_BACKEND=resend
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional. Leave unset to disable Sentry locally.
SENTRY_DSN=
# Fraction of requests traced (0.0-1.0). Ignored while SENTRY_DSN is unset.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Social OAuth (T-023) ---
# Leave a provider's pair blank to disable its /api/v1/auth/oauth/{provider} route.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Storage ---
# "s3" | "r2" | "minio"
STORAGE_BACKEND=minio
AWS_BUCKET_NAME=forge-local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Only set for MinIO/R2 (S3-compatible custom endpoint). Leave unset for real AWS S3.
AWS_ENDPOINT_URL=http://localhost:9000

# --- Encryption (column-level Fernet, see EncryptedString in T-009.5) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated legacy keys, only set during key rotation.
ENCRYPTION_KEY_OLD=
# Defaults for the re-encryption job (docs/runbooks/encryption-key-rotation.md).
# Raise the batch size / drop the throttle only for a maintenance window.
ENCRYPTION_ROTATION_BATCH_SIZE=500
ENCRYPTION_ROTATION_THROTTLE_SECONDS=0.1

# --- TLS enforcement ---
# Must be "true" in staging/prod — startup raises RuntimeError otherwise (§0.6).
FORCE_HTTPS=false

# --- GDPR (T-033) ---
# Days between DELETE /me (soft-delete) and the purge_user_data hard-delete job (T-036).
GDPR_PURGE_GRACE_DAYS=30

# --- Notifications (T-103) ---
# Global cap on concurrently open /api/v1/notifications/stream SSE connections.
SSE_MAX_CONNECTIONS=10000

# --- Notification retention (T-219) ---
# Age (days, from created_at) at which an in-app Notification row is hard-deleted.
NOTIFICATION_RETENTION_DAYS=90

# --- Virus scanning (T-113) ---
# "clamav" | "virustotal" | "noop". "noop" (default) marks every upload clean immediately.
# Must not be "noop" outside dev — startup raises RuntimeError otherwise (T-225).
VIRUS_SCANNER=noop
# Only used when VIRUS_SCANNER=clamav. docker-compose.prod.yml's optional clamav service.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Only used when VIRUS_SCANNER=virustotal.
VIRUSTOTAL_API_KEY=

# --- Superadmin (T-140) ---
# Dedicated Loguru sink every superadmin action is written to, in addition to
# the normal log stream. Relative paths resolve against the backend process's cwd.
ADMIN_AUDIT_LOG_PATH=admin-audit.log

# --- Password pepper (T-225/ASVS V2.4.5) ---
# HMAC key mixed into every password before Argon2, on top of Argon2's own per-hash
# salt. Blank in dev. Must be set outside dev — startup raises RuntimeError otherwise.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PASSWORD_PEPPER=
