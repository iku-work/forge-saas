# T-244: config for docker-compose.prod.yml's pgbouncer service.
#
# Its own file rather than keys in backend/.env for the same reason as
# .env.postgres.example / .env.postgres-exporter.example: none of these are
# fields on Settings (backend/app/core/config.py), which sets extra="forbid".
#
# Copy to .env.pgbouncer and fill in real values; do not commit the real file.
# Every setting below maps to a pgbouncer.ini key of the same name, lowercased
# -- see https://www.pgbouncer.org/config.html and docs/adr/0002-pgbouncer.md.

# The upstream Postgres. The image's entrypoint parses this into both the
# [databases] entry and the auth_file userlist -- this single line is the
# "userlist from env" wiring; no credentials live in the image. Keep it in
# sync with .env.postgres.
DATABASE_URL=postgres://postgres:change-me@postgres:5432/forge

# 6432, not pgbouncer's own default of 5432 in this image -- a DATABASE_URL
# ending in :6432 is unambiguously pointed at the pooler, and a stray
# direct-to-Postgres URL can't accidentally work.
LISTEN_PORT=6432

# The whole point of T-244. Session mode would pin one Postgres backend per
# client connection for its entire lifetime, i.e. exactly the connection
# count this is meant to flatten. Statement mode is stricter still and would
# break multi-statement transactions, which this app uses everywhere.
POOL_MODE=transaction

# scram-sha-256, not md5: Postgres 14+ (this stack runs 16) defaults to
# scram-sha-256 for password_encryption, and pgbouncer can only present the
# server the credential form it holds. With AUTH_TYPE=md5 the entrypoint
# stores an md5 digest in the userlist and every server-side login fails.
AUTH_TYPE=scram-sha-256
ADMIN_USERS=postgres

# Sizing, against Postgres' default max_connections=100 and
# superuser_reserved_connections=3 (T-244's brief: max_connections * 0.8,
# minus a superuser reserve):
#   75 + 5 reserve = 80 server connections = 80% of max_connections.
#   The remaining 20 cover the 3 reserved superuser slots, the
#   postgres-exporter service (which connects directly, not through here),
#   Alembic via MIGRATIONS_DATABASE_URL, and ad-hoc psql.
# Raise max_connections on the Postgres side before raising these.
DEFAULT_POOL_SIZE=75
RESERVE_POOL_SIZE=5
RESERVE_POOL_TIMEOUT=3
MAX_DB_CONNECTIONS=80

# Client side, i.e. how many backend/worker connections may be *held* at once
# across every replica: replicas x (DB_POOL_SIZE + DB_MAX_OVERFLOW). Cheap --
# an idle client connection costs pgbouncer a socket, not a Postgres backend.
MAX_CLIENT_CONN=1000

# Required, not cosmetic. app.core.db gives every prepared statement a unique
# UUID name (see build_connect_args) so multiplexed clients can't collide;
# the flip side is that nothing ever reuses a name, so without a reset on
# release those statements pile up on each server connection until it is
# recycled. Measured on a synthetic churn workload: ~115 statements per
# server connection and still climbing without this, 1 with it. In
# transaction mode pgbouncer only runs server_reset_query when
# server_reset_query_always is on -- both lines are needed.
SERVER_RESET_QUERY=DISCARD ALL
SERVER_RESET_QUERY_ALWAYS=1

# 0 = pgbouncer does not track prepared statements itself. Deliberate: the
# app already disables every layer of prepared-statement reuse (unique names,
# no caching), so pgbouncer's own cache would only fill with names nothing
# ever asks for again. This is the knob to revisit if the re-parse cost
# measured in docs/adr/0002-pgbouncer.md ever matters -- see that ADR's
# "Revisiting this" section, which requires changing app.core.db too.
MAX_PREPARED_STATEMENTS=0

# asyncpg sends extra_float_digits and (via SQLAlchemy) a few other startup
# parameters pgbouncer can't proxy per-transaction; ignoring them is the
# standard configuration rather than failing the connection.
IGNORE_STARTUP_PARAMETERS=extra_float_digits,search_path

# Used only by the compose healthcheck's psql invocation.
PGPASSWORD=change-me
DB_USER=postgres
DB_NAME=forge
