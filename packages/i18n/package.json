{
  "name": "@forge/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*": "./locales/*"
  },
  "files": ["dist", "locales"],
  "scripts": {
    "generate-types": "tsx scripts/generate-types.ts",
    "check-locales": "tsx scripts/check-locales.ts",
    "check-roundtrip": "tsx scripts/check-roundtrip.ts",
    "i18n:export": "tsx scripts/i18n-export.ts",
    "i18n:import": "tsx scripts/i18n-import.ts",
    "build": "pnpm run generate-types && tsup",
    "dev": "tsup --watch",
    "lint": "pnpm run check-locales && pnpm run check-roundtrip",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "intl-messageformat": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
