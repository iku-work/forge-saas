{
  "name": "@forge/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "generate": "node ./scripts/dump-openapi.mjs && openapi-ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
