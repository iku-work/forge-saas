{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // src/generated/ is gitignored (it is produced by `make gen-client` from
    // the live OpenAPI schema), and turbo's default input set is a package's
    // *git-tracked* files -- so without the extra input below, regenerating
    // the client does not change this task's cache key and `turbo build`
    // restores a dist built from the previous schema. The failure is silent
    // and confusing: type-check then reports a brand-new endpoint's symbols
    // as missing from a package that was, apparently, just rebuilt.
    // $TURBO_DEFAULT$ keeps the normal inputs and adds the generated tree.
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "src/generated/**"]
    }
  }
}
