{
  "expo": {
    "name": "ForgeSaaS",
    "slug": "forge-saas",
    "scheme": "forge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.forgesaas.mobile"
    },
    "android": {
      "package": "com.forgesaas.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach files.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to attach files."
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
