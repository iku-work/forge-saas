{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "size": "size-limit"
  },
  "dependencies": {
    "@forge/api-client": "workspace:*",
    "@forge/hooks": "workspace:*",
    "@forge/i18n": "workspace:*",
    "@forge/types": "workspace:*",
    "@forge/ui": "workspace:*",
    "@forge/utils": "workspace:*",
    "@forge/validation": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "^10.63.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-virtual": "^3.13.12",
    "i18next": "^26.3.3",
    "intl-messageformat": "^10.7.18",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@size-limit/file": "^13.0.3",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.7.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^13.0.3",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "size-limit": [
    {
      "name": "entry — initial JS (login lands here)",
      "path": "dist/assets/entry-*.js",
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "vendor — shared async chunk (sonner + lucide-react)",
      "path": "dist/assets/index-*.js",
      "limit": "76 KB",
      "gzip": true
    },
    {
      "name": "CSS — total stylesheet",
      "path": "dist/assets/*.css",
      "limit": "8 KB",
      "gzip": true
    },
    {
      "name": "VirtualList — shared virtualization (T-241)",
      "path": "dist/assets/VirtualList-*.js",
      "limit": "9 KB",
      "gzip": true
    },
    {
      "name": "route — app shell (_app layout)",
      "path": "dist/assets/_locale._app-*.js",
      "limit": "6.2 KB",
      "gzip": true
    },
    {
      "name": "route — dashboard (_app index)",
      "path": "dist/assets/_locale._app.index-*.js",
      "limit": "0.4 KB",
      "gzip": true
    },
    {
      "name": "route — reports",
      "path": "dist/assets/_locale._app.reports-*.js",
      "limit": "0.4 KB",
      "gzip": true
    },
    {
      "name": "route — files",
      "path": "dist/assets/_locale._app.files-*.js",
      "limit": "1.5 KB",
      "gzip": true
    },
    {
      "name": "route — settings/security",
      "path": "dist/assets/_locale._app.settings.security-*.js",
      "limit": "5.2 KB",
      "gzip": true
    },
    {
      "name": "route — settings/members",
      "path": "dist/assets/_locale._app.settings.members-*.js",
      "limit": "2.7 KB",
      "gzip": true
    },
    {
      "name": "route — settings/billing",
      "path": "dist/assets/_locale._app.settings.billing-*.js",
      "limit": "2.3 KB",
      "gzip": true
    },
    {
      "name": "route — settings/notifications",
      "path": "dist/assets/_locale._app.settings.notifications-*.js",
      "limit": "1.3 KB",
      "gzip": true
    },
    {
      "name": "route — settings/org",
      "path": "dist/assets/_locale._app.settings.org-*.js",
      "limit": "1.4 KB",
      "gzip": true
    },
    {
      "name": "route — settings/profile",
      "path": "dist/assets/_locale._app.settings.profile-*.js",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "route — admin shell",
      "path": "dist/assets/_locale.admin-*.js",
      "limit": "1.5 KB",
      "gzip": true
    },
    {
      "name": "route — admin/index",
      "path": "dist/assets/_locale.admin.index-*.js",
      "limit": "1.1 KB",
      "gzip": true
    },
    {
      "name": "route — admin/users",
      "path": "dist/assets/_locale.admin.users-*.js",
      "limit": "1.4 KB",
      "gzip": true
    },
    {
      "name": "route — admin/users/:id",
      "path": "dist/assets/_locale.admin.users_._id-*.js",
      "limit": "2.1 KB",
      "gzip": true
    },
    {
      "name": "route — admin/orgs",
      "path": "dist/assets/_locale.admin.orgs-*.js",
      "limit": "1.4 KB",
      "gzip": true
    },
    {
      "name": "route — admin/orgs/:id",
      "path": "dist/assets/_locale.admin.orgs_._id-*.js",
      "limit": "3.4 KB",
      "gzip": true
    },
    {
      "name": "route — admin/audit",
      "path": "dist/assets/_locale.admin.audit-*.js",
      "limit": "1.5 KB",
      "gzip": true
    },
    {
      "name": "routes — public/auth (login, register, invitation, email flows)",
      "path": [
        "dist/assets/_locale.login-*.js",
        "dist/assets/_locale.register-*.js",
        "dist/assets/_locale.magic-link-*.js",
        "dist/assets/_locale.forgot-password-*.js",
        "dist/assets/_locale.reset-password-*.js",
        "dist/assets/_locale.verify-email-*.js",
        "dist/assets/_locale.confirm-email-change-*.js",
        "dist/assets/_locale.cancel-email-change-*.js",
        "dist/assets/_locale.accept-invitation._token-*.js",
        "dist/assets/_locale-*.js"
      ],
      "limit": "12.5 KB",
      "gzip": true
    },
    {
      "name": "shared — misc route runtime helpers",
      "path": [
        "dist/assets/AuthCard-*.js",
        "dist/assets/getErrorMessage-*.js",
        "dist/assets/toAuthenticatorAttachment-*.js",
        "dist/assets/useDebouncedValue-*.js",
        "dist/assets/useRouterState-*.js",
        "dist/assets/useRouteLocale-*.js"
      ],
      "limit": "2.6 KB",
      "gzip": true
    },
    {
      "name": "shared — zod",
      "path": "dist/assets/zod-*.js",
      "limit": "2.3 KB",
      "gzip": true
    },
    {
      "name": "i18n — errors (all locales)",
      "path": "dist/assets/errors-*.js",
      "limit": "18.5 KB",
      "gzip": true
    },
    {
      "name": "i18n — auth (all locales)",
      "path": "dist/assets/auth-*.js",
      "limit": "17 KB",
      "gzip": true
    },
    {
      "name": "i18n — emails (all locales)",
      "path": "dist/assets/emails-*.js",
      "limit": "15 KB",
      "gzip": true
    },
    {
      "name": "i18n — common (all locales)",
      "path": "dist/assets/common-*.js",
      "limit": "14.5 KB",
      "gzip": true
    },
    {
      "name": "i18n — notifications (all locales)",
      "path": "dist/assets/notifications-*.js",
      "limit": "7.5 KB",
      "gzip": true
    },
    {
      "name": "i18n — tenancy (all locales)",
      "path": "dist/assets/tenancy-*.js",
      "limit": "6.2 KB",
      "gzip": true
    },
    {
      "name": "i18n — files (all locales)",
      "path": "dist/assets/files-*.js",
      "limit": "5.5 KB",
      "gzip": true
    },
    {
      "name": "i18n — billing (all locales)",
      "path": "dist/assets/billing-*.js",
      "limit": "4.3 KB",
      "gzip": true
    },
    {
      "name": "i18n — validation (all locales)",
      "path": "dist/assets/validation-*.js",
      "limit": "2.7 KB",
      "gzip": true
    },
    {
      "name": "i18n — users (all locales)",
      "path": "dist/assets/users-*.js",
      "limit": "0.8 KB",
      "gzip": true
    }
  ]
}
