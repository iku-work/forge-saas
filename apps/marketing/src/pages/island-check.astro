---
/**
 * A diagnostic page, not marketing copy.
 *
 * It exists because two of this task's requirements pull in opposite
 * directions: `/` must ship zero script bytes, and a @forge/ui component must
 * be proven to hydrate. Both hold if the proof lives on a page that is not
 * `/`. This is that page -- noindex, unlinked from the site, and the reason
 * the strings on it are English literals rather than @forge/i18n keys: it
 * addresses whoever is changing the build, not a visitor.
 *
 * T-301 lands the pricing toggle, which is a real island on a real page.
 * Delete this page then, and move the assertion in tests/build.test.ts onto
 * that one -- what has to survive is the assertion, not this page.
 */
import { IslandCheck } from "../components/IslandCheck";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Island check";
const description =
  "Proves a @forge/ui React component hydrates in Astro with the package unmodified.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">{description}</p>
    <div class="mt-8">
      <IslandCheck client:load label="Increment" countLabel="Clicks" />
    </div>
  </section>
</BaseLayout>
