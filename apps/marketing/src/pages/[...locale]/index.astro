---
/**
 * The landing page. Zero script bytes, asserted by tests/build.test.ts --
 * @forge/ui's button classes and the hero's picture of the product (the app
 * shell and checklist, see HeroProduct.tsx) render here as HTML, with no
 * React in the output at all.
 *
 * Under `[...locale]` since T-301: one file, one copy of the markup, built
 * once per enabled locale. See src/lib/routing.ts for where the locale sits
 * in the URL and who owns that decision.
 */
import { buttonVariants } from "@forge/ui";

import FaqSection from "../../components/FaqSection.astro";
import HeroProduct from "../../components/HeroProduct";
import { site } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { productFaq } from "../../lib/faq";
import { translator } from "../../lib/i18n";
import { loadPlans } from "../../lib/plans";
import { appLink, modules } from "../../lib/product";
import { localePath, localeStaticPaths } from "../../lib/routing";
import { absoluteUrl } from "../../lib/site-url";
import { softwareApplicationSchema } from "../../lib/structured-data";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = translator(locale);

// The billing highlight is a claim about the product, so it follows the
// module that makes the claim true: with `billing` off there are no plans,
// no trials and no dunning, and advertising them is the marketing half of
// the half-applied toggle docs/runbooks/module-toggle-guide.md warns about.
const highlights = [
  {
    title: t("marketing.highlights.accounts_title"),
    body: t("marketing.highlights.accounts_body"),
    enabled: true,
  },
  {
    title: t("marketing.highlights.billing_title"),
    body: t("marketing.highlights.billing_body"),
    enabled: modules.billing,
  },
  {
    title: t("marketing.highlights.operations_title"),
    body: t("marketing.highlights.operations_body"),
    enabled: true,
  },
].filter((highlight) => highlight.enabled);

// The product, described to a crawler in the same sentence the hero shows a
// reader (T-303). The price range comes from the same catalogue /pricing
// renders -- `loadPlans` fetches it once per build, not once per page -- and
// with `billing` off there is no catalogue and the node carries no offer.
const { plans } = modules.billing
  ? await loadPlans()
  : { plans: [] as Awaited<ReturnType<typeof loadPlans>>["plans"] };

const schema = softwareApplicationSchema({
  astroSite: Astro.site,
  url: absoluteUrl(Astro.url.pathname, Astro.site),
  description: t("marketing.hero.subtitle"),
  locale,
  plans,
  pricingUrl: modules.billing
    ? absoluteUrl(localePath(locale, "pricing"), Astro.site)
    : undefined,
});
---

<BaseLayout
  title={site.name}
  description={t("marketing.hero.subtitle")}
  locale={locale}
  schema={schema}
  wide
>
  <section class="mx-auto max-w-[75rem] px-6 pt-18">
    <h1
      class="max-w-[13ch] text-balance text-[clamp(2.75rem,3.5vw+1.5rem,5.25rem)] font-semibold leading-[1.02] tracking-[-0.035em] [font-stretch:78%]"
    >
      {t("marketing.hero.title")}
    </h1>
    <p class="mt-6 max-w-[34rem] text-pretty text-xl text-foreground-secondary">
      {t("marketing.hero.subtitle")}
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-5">
      <a
        href={appLink("register", locale)}
        class={buttonVariants({ size: "lg", className: "h-11 px-5 text-[0.9375rem]" })}
      >
        {t("marketing.hero.cta_primary")}
      </a>
      <a href={localePath(locale, "guides")} class="font-medium text-foreground hover:underline">
        {t("marketing.hero.cta_guides")}
      </a>
    </div>
    {/* A picture of the product, not part of the page's content or tab
        order: hidden from assistive technology and inert. */}
    <div class="frame mt-16" aria-hidden="true" inert>
      <div class="frame-inner">
        <HeroProduct t={t} />
      </div>
    </div>
  </section>

  <section
    aria-label={t("marketing.highlights.heading")}
    class="mx-auto grid max-w-[75rem] gap-10 px-6 pb-36 pt-16 md:grid-cols-3"
  >
    {
      highlights.map((highlight) => (
        <div>
          <h2 class="border-t border-border-strong pt-4 text-base font-semibold">{highlight.title}</h2>
          <p class="mt-2 text-foreground-secondary">{highlight.body}</p>
        </div>
      ))
    }
  </section>

  <FaqSection questions={productFaq()} t={t} />
</BaseLayout>

<style>
  /* The real shell, zoomed out, fading into the page. */
  .frame {
    height: 35rem;
    overflow: hidden;
    border-radius: 1rem 1rem 0 0;
    background: var(--background);
    box-shadow:
      0 0 0 1px var(--border),
      0 30px 80px -30px rgb(23 26 33 / 0.25);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
    /* The one orchestrated moment: the frame rises, then the checklist
       settles. Once, on load, CSS only. */
    animation: rise 640ms var(--ease-out-soft) both 120ms;
  }
  /* zoom, not transform: the shell lays itself out at the larger size (its
     container queries see the zoomed-out width, so it is a desktop shell),
     and then the whole thing is drawn smaller. */
  .frame-inner {
    zoom: 0.8;
    height: 43.75rem;
  }
  .frame :global(ol > li) {
    animation: settle 420ms var(--ease-out-soft) both;
  }
  .frame :global(ol > li:nth-child(1)) {
    animation-delay: 520ms;
  }
  .frame :global(ol > li:nth-child(2)) {
    animation-delay: 580ms;
  }
  .frame :global(ol > li:nth-child(3)) {
    animation-delay: 640ms;
  }
  .frame :global(ol > li:nth-child(4)) {
    animation-delay: 700ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  /* On a phone the shell is narrower than its sidebar breakpoint, so only
     the panel shows -- the same thing the app does at that width. */
  @media (max-width: 767px) {
    .frame {
      height: 22.5rem;
    }
    .frame-inner {
      zoom: 0.72;
      height: 31.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame,
    .frame :global(ol > li) {
      animation: none;
    }
  }
</style>
