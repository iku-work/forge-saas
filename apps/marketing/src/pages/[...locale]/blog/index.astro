---
/**
 * The blog index: the posts published in this page's locale, newest first.
 *
 * The list is empty in a locale nothing has been translated into, and that is
 * the intended answer rather than a fallback to English -- T-305's rule, and
 * the reason src/content/blog is keyed by locale. The empty state says so in
 * the visitor's own language.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { blogPosts } from "../../../lib/content";
import { formatDate, isoDate, translator } from "../../../lib/i18n";
import { localePath, localeStaticPaths } from "../../../lib/routing";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = translator(locale);
const posts = await blogPosts(locale);
---

<BaseLayout
  title={t("marketing.blog.title")}
  description={t("marketing.blog.subtitle")}
  locale={locale}
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="type-display">{t("marketing.blog.title")}</h1>
    <p class="mt-4 text-pretty text-lg text-muted-foreground">
      {t("marketing.blog.subtitle")}
    </p>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-muted-foreground" data-testid="blog-empty">
          {t("marketing.blog.empty")}
        </p>
      ) : (
        <ul class="mt-12 space-y-10">
          {posts.map(({ slug, entry }) => (
            <li>
              <article>
                <h2 class="text-xl font-semibold tracking-tight">
                  <a class="underline-offset-4 hover:underline" href={localePath(locale, `blog/${slug}`)}>
                    {entry.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm text-muted-foreground">
                  <time datetime={isoDate(entry.data.publishedAt)}>
                    {t("marketing.blog.published_on", {
                      date: formatDate(entry.data.publishedAt, locale),
                    })}
                  </time>
                  {" · "}
                  {t("marketing.blog.by_author", { author: entry.data.author })}
                </p>
                <p class="mt-3 text-pretty text-muted-foreground">{entry.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
