---
/**
 * The locale-less half of T-305's prefix policy: `/pricing` resolves to a
 * locale and sends the visitor to `/fi/pricing/`.
 *
 * apps/web does this in `$.tsx` and `index.tsx` (T-233), in the router, with
 * three inputs to resolve from: the signed-in user's stored preference, an
 * explicit in-session choice, and the browser's languages. This site is
 * `output: "static"` -- there is no request to hook, no session to read, and
 * (T-307) not even the same origin as the app, so a cookie or a localStorage
 * entry written there is invisible here by design. What is left is the one
 * input a public, cacheable, session-less page does have: the browser's own
 * language list, then the product's default. Same order, minus the tiers that
 * do not exist on this side.
 *
 * Two pages render this. `/` is where the apex domain lands, and it is the
 * only page in the build whose whole job is to send you somewhere else. The
 * 404 is the other half: a static host has one file it can serve for an
 * unmatched path, so a locale-less deep link like `/pricing` arrives there,
 * and rewriting it to `/en/pricing/` is what keeps every such URL working
 * rather than dead-ending on a page that says the site has moved on.
 *
 * **T-307 should promote this to a redirect at the edge.** Caddy can answer
 * `/pricing` with a 301 to the prefixed URL, which is a better answer than a
 * 404 plus a rewrite, and it is the same note T-233 leaves for an SSR layer.
 * Until then this is the only mechanism a directory of files has.
 *
 * The locale list travels on a data attribute rather than through
 * `define:vars` because that directive forces `is:inline`, which skips the
 * TypeScript compilation and the minification every other script here gets.
 * Astro still inlines the compiled result, being a few hundred bytes, and
 * that is the right trade for a page whose entire job is to leave: a separate
 * request would add a round trip to the one page nobody should be looking at.
 *
 * **T-307's CSP therefore needs this script's hash, not `'unsafe-inline'`.**
 * A hash covers one exact block and nothing else; `'unsafe-inline'` would
 * permit every injected script on the site to buy this one 300 bytes.
 */
import { defaultLocale, enabledLocales } from "../lib/routing";
---

<span
  data-locale-redirect
  data-locales={enabledLocales.join(" ")}
  data-fallback={defaultLocale}
  hidden></span>

<script>
  const marker = document.querySelector<HTMLElement>("[data-locale-redirect]");
  const locales = (marker?.dataset["locales"] ?? "").split(" ").filter(Boolean);
  const fallback = marker?.dataset["fallback"] ?? "";
  const { pathname, search, hash } = window.location;
  const segments = pathname.split("/").filter(Boolean);

  // A path that already carries a locale is left alone. That is what stops
  // the 404 from bouncing: `/en/nope` is a genuine 404 and stays one, exactly
  // as `/en/nope` is in the app rather than being re-prefixed forever.
  if (locales.length > 0 && !locales.includes(segments[0] ?? "")) {
    const tags = navigator.languages?.length
      ? navigator.languages
      : [navigator.language];
    // Matched on the language subtag alone: a browser asking for `de-AT` is
    // asking for German, and this site has one German. Same reduction
    // apps/web's resolvePreferredLocale() makes.
    const preferred =
      tags
        .map((tag) => (tag ?? "").toLowerCase().split("-")[0] ?? "")
        .find((base) => locales.includes(base)) ?? fallback;

    // Trailing slash, because `build.format` is "directory" and every page
    // here is served at one -- except the 404 itself, which is a file. A last
    // segment with a dot in it is that case, and a redirect that appended a
    // slash to it would ask for a directory that cannot exist.
    const last = segments[segments.length - 1] ?? "";
    const target = `/${[preferred, ...segments].join("/")}${last.includes(".") ? "" : "/"}`;

    // replace(), not assign(): the URL the visitor typed and the one they
    // land on should not be two steps of the back button, which is the same
    // call T-233's localeRedirect() makes for the same reason.
    window.location.replace(`${target}${search}${hash}`);
  }
</script>
